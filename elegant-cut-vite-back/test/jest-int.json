{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/test/pruebas integracion"
  ],
  "testRegex": ".*\\.spec\\.ts$",
  "testPathIgnorePatterns": [
    "\\.e2e-spec\\.ts$"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "setupFilesAfterEnv": [
    "<rootDir>/test/setup-silent-logger.ts"
  ],
  "reporters": [
    "default",
    [
      "<rootDir>/test/reporters/markdown-reporter.js",
      {
        "outputFile": "test-report-int.md",
        "title": "Reporte de Pruebas de Integración"
      }
    ]
  ]
}
